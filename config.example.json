{
  "_comment": "Example Configuration for Options Trading Script - Copy this file to config.json and fill in your values. DO NOT commit config.json with real credentials!",
  "api": {
    "client_id": "YOUR_CLIENT_ID_HERE",
    "account_id": "YOUR_ACCOUNT_ID_HERE",
    "redirect_uri": "https://localhost"
  },
  "trading": {
    "risk_per_trade": 0.02,
    "max_position_size": 10,
    "default_strategy": "vertical_spread",
    "min_days_to_expiration": 7,
    "max_days_to_expiration": 45
  },
  "risk_management": {
    "profit_target_percent": 0.50,
    "stop_loss_percent": 0.50,
    "max_daily_loss": 1000,
    "max_daily_trades": 5
  },
  "filters": {
    "min_volume": 100,
    "min_open_interest": 1000,
    "max_bid_ask_spread_percent": 0.10,
    "min_liquidity_score": 50
  },
  "logging": {
    "level": "INFO",
    "file": "options_trader.log",
    "max_bytes": 10485760,
    "backup_count": 5
  }
}
